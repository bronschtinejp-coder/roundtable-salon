* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --primary: #FF6600;
  --primary-light: #FF8533;
  --bg: #1A1A2E;
  --card-bg: #25253E;
  --text: #F0F0F0;
  --text-secondary: #A0A0B8;
  --border: #3A3A55;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  min-height: 100vh;
}

a {
  color: inherit;
}

.hidden {
  display: none !important;
}

.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 32px 24px 80px;
}

.header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--card-bg);
  border-bottom: 1px solid var(--border);
  padding: 18px 32px;
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: center;
}

.header-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--primary);
  margin-right: 16px;
}

.header-subtitle {
  color: var(--text-secondary);
  font-size: 14px;
}

.header-nav {
  display: flex;
  gap: 12px;
  align-items: center;
}

.header-nav a {
  padding: 8px 14px;
  border-radius: 10px;
  background: transparent;
  color: var(--text-secondary);
  text-decoration: none;
  border: 1px solid transparent;
  transition: all 0.2s ease;
}

.header-nav a:hover {
  color: var(--text);
  border-color: var(--primary);
  box-shadow: 0 8px 18px var(--primary-light);
}

.overlay {
  position: fixed;
  inset: 0;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.overlay-box {
  background: var(--card-bg);
  border-radius: 14px;
  border: 1px solid var(--border);
  padding: 28px 32px;
  min-width: 320px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  text-align: center;
}

.overlay-box h2 {
  font-size: 20px;
  color: var(--text);
}

.overlay-box input {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  color: var(--text);
  outline: none;
}

.overlay-box button {
  padding: 10px 12px;
  border-radius: 10px;
  border: none;
  background: var(--primary);
  color: var(--text);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.overlay-box button:hover {
  background: var(--primary-light);
}

.error {
  color: var(--primary);
  font-size: 13px;
}

.hero {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 28px;
  margin-bottom: 24px;
  box-shadow: 0 10px 30px var(--bg);
}

.hero h1 {
  font-size: 32px;
  margin-bottom: 8px;
}

.hero p {
  color: var(--text-secondary);
  max-width: 680px;
}

.stats-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
  margin-top: 18px;
}

.stat-card {
  padding: 14px 16px;
  border-radius: 12px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  text-align: center;
}

.stat-card span {
  color: var(--primary);
  font-size: 20px;
  font-weight: 700;
}

.search-bar {
  margin-bottom: 18px;
  display: flex;
  gap: 12px;
  align-items: center;
}

.search-input {
  flex: 1;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  color: var(--text);
  outline: none;
}

.search-clear {
  padding: 10px 14px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-secondary);
  cursor: pointer;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.tag-pill {
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid var(--border);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 13px;
}

.tag-pill.active,
.tag-pill:hover {
  border-color: var(--primary);
  color: var(--text);
  box-shadow: 0 8px 18px var(--primary-light);
}

.clear-filters {
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid var(--primary);
  color: var(--primary);
  background: transparent;
  cursor: pointer;
  font-size: 13px;
}

.topics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.topic-card,
.case-card {
  background: var(--card-bg);
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 18px;
  transition: all 0.2s ease;
  cursor: pointer;
}

.topic-card:hover,
.case-card:hover {
  border-color: var(--primary);
  box-shadow: 0 12px 22px var(--primary-light);
  transform: translateY(-2px);
}

.topic-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 8px;
}

.topic-desc {
  color: var(--text-secondary);
  font-size: 14px;
  margin-bottom: 12px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.topic-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  color: var(--text-secondary);
  font-size: 13px;
}

.topic-tags,
.case-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.topic-tag,
.case-tag {
  padding: 4px 10px;
  border-radius: 999px;
  background: var(--bg);
  color: var(--primary);
  border: 1px solid var(--primary);
  font-size: 12px;
}

.topic-detail {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.topic-detail-header {
  background: var(--card-bg);
  border-radius: 16px;
  border: 1px solid var(--border);
  padding: 22px;
}

.back-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--primary);
  text-decoration: none;
  margin-bottom: 12px;
  font-weight: 600;
}

.case-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.case-card h3 {
  font-size: 16px;
  margin-bottom: 8px;
}

.case-meta {
  color: var(--text-secondary);
  font-size: 13px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.case-excerpt {
  margin-top: 10px;
  font-size: 13px;
  color: var(--text-secondary);
}

.interaction-bar {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

.interaction-btn {
  flex: 1;
  padding: 8px 10px;
  border-radius: 10px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s ease;
}

.interaction-btn.active {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--bg);
}

.discussion {
  margin-top: 18px;
  padding: 18px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: var(--card-bg);
}

.discussion h3 {
  margin-bottom: 10px;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 300;
  padding: 32px;
}

.modal {
  background: var(--card-bg);
  border-radius: 16px;
  border: 1px solid var(--border);
  width: min(900px, 90vw);
  max-height: 90vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 22px;
  border-bottom: 1px solid var(--border);
}

.modal-title {
  font-size: 20px;
  font-weight: 600;
}

.modal-close {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  cursor: pointer;
}

.modal-body {
  padding: 20px 22px 28px;
  overflow-y: auto;
}

.modal-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  color: var(--text-secondary);
  margin-bottom: 14px;
}

.modal-meta a {
  color: var(--primary);
  text-decoration: none;
}

.section-block {
  padding: 14px;
  border-radius: 12px;
  border: 1px solid var(--border);
  margin-bottom: 12px;
  background: var(--bg);
}

.section-block h3 {
  margin-bottom: 6px;
  font-size: 15px;
}

.comment-placeholder {
  margin-top: 16px;
  padding: 14px;
  border-radius: 12px;
  border: 1px dashed var(--border);
  color: var(--text-secondary);
  text-align: center;
}

.empty-state {
  padding: 32px;
  border-radius: 16px;
  border: 1px solid var(--border);
  background: var(--card-bg);
  text-align: center;
  color: var(--text-secondary);
}

.profile {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
}

.profile-avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
  color: var(--text);
}

.profile-actions button {
  padding: 8px 14px;
  border-radius: 10px;
  border: 1px solid var(--primary);
  background: transparent;
  color: var(--primary);
  cursor: pointer;
  margin-top: 8px;
}

.profile-stats {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  color: var(--text-secondary);
}

.utility-section {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px;
}

.utility-section h3 {
  margin-bottom: 12px;
}

@media (max-width: 980px) {
  .topics-grid {
    grid-template-columns: 1fr;
  }

  .case-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .header {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 720px) {
  .case-grid {
    grid-template-columns: 1fr;
  }
}

/* === V1.1 Chat Bubble Styles === */

.case-detail-header {
  padding: 24px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 8px;
}

.case-detail-header h2 {
  font-size: 22px;
  margin-bottom: 12px;
}

.case-detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  color: var(--text-secondary);
  font-size: 14px;
}

.case-detail-meta span {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.chat-container {
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.chat-pair {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* Question bubble — left aligned */
.chat-question {
  display: flex;
  justify-content: flex-start;
  max-width: 80%;
}

.chat-question-bubble {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 2px 16px 16px 16px;
  padding: 16px 20px;
}

.chat-question-bubble p {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.7;
}

/* Answer bubble — right aligned, with avatar */
.chat-answer {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  max-width: 85%;
  align-self: flex-end;
}

.chat-answer-content {
  flex: 1;
  min-width: 0;
}

.chat-answer-bubble {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px 2px 16px 16px;
  padding: 16px 20px;
}

.chat-answer-bubble p {
  font-size: 14px;
  color: var(--text);
  line-height: 1.8;
}

.chat-answer-bubble p + p {
  margin-top: 10px;
}

.chat-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 700;
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 2px;
}

/* Images inside answer */
.chat-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.chat-images img {
  max-width: 100%;
  max-height: 300px;
  border-radius: 8px;
  border: 1px solid var(--border);
  cursor: pointer;
  transition: opacity 0.2s;
  object-fit: contain;
  background: var(--bg);
}

.chat-images img:hover {
  opacity: 0.85;
}

/* QA index label */
.chat-question-label {
  font-size: 12px;
  color: var(--primary);
  font-weight: 600;
  margin-bottom: 6px;
}

.chat-answer-label {
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 6px;
  text-align: right;
}
